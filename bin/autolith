#!/usr/bin/env bash

set -u

resolve_path()
{
  local path=$1
  local directory
  local target

  case "$path" in
    /*) ;;
    *) path=$PWD/$path ;;
  esac
  while [[ -L "$path" ]]; do
    directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    case "$target" in
      /*) path=$target ;;
      *) path=$directory/$target ;;
    esac
  done
  directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd) || return 1
  printf '%s/%s\n' "$directory" "$(basename "$path")"
}

xdg_base_directory()
{
  case ${1:-} in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$2" ;;
  esac
}

launcher_path=$(resolve_path "${BASH_SOURCE[0]}")
source_root=$(CDPATH= cd -P "$(dirname "$launcher_path")/.." && pwd)

# shellcheck source=../script/launcher-cli.sh
source "$source_root/script/launcher-cli.sh" || exit 1
case $source_root in
  /nix/store/*) autolith_launcher_parse nix "$@" ;;
  *) autolith_launcher_parse source "$@" ;;
esac
source_checksums_path=$source_root/sbcl-source-releases.sha256
terminal_state=
state_home=$(xdg_base_directory "${XDG_STATE_HOME:-}" "$HOME/.local/state")
config_home=$(xdg_base_directory "${XDG_CONFIG_HOME:-}" "$HOME/.config")
cache_home=$(xdg_base_directory "${XDG_CACHE_HOME:-}" "$HOME/.cache")
data_home=$(xdg_base_directory "${XDG_DATA_HOME:-}" "$HOME/.local/share")
data_home=${data_home%/}
[ -n "$data_home" ] || data_home=/
# shellcheck source=../script/migrate-launcher-data
source "$source_root/script/migrate-launcher-data" || exit 1
autolith_migrate_launcher_data "$data_home" || exit 1
autolith_migrate_launcher_credentials "$state_home" || exit 1
autolith_migrate_launcher_mcp_configuration "$config_home" || exit 1
launcher_data_root=$data_home/autolith-launcher
runtime_command_path=$launcher_data_root/runtimes/command
inherited_runtime_source_root=${AUTOLITH_SBCL_SOURCE_ROOT:-}
configured_sbcl=${AUTOLITH_SBCL:-}
recorded_runtime=
if [[ -r "$runtime_command_path" ]]; then
  IFS= read -r recorded_runtime < "$runtime_command_path" || recorded_runtime=
fi
if [[ -n ${AUTOLITH_SBCL:-} ]]; then
  sbcl_command=$AUTOLITH_SBCL
elif [[ "$recorded_runtime" == /* && -x "$recorded_runtime" ]]; then
  sbcl_command=$recorded_runtime
else
  sbcl_command=sbcl
fi
export AUTOLITH_SBCL=$sbcl_command
selected_runtime_version=
if [[ -d "$launcher_data_root/runtimes" ]] &&
   selected_runtime_probe=$("$sbcl_command" --version 2>/dev/null); then
  selected_runtime_version=${selected_runtime_probe#SBCL }
  selected_runtime_version=${selected_runtime_version%% *}
fi
runtime_source_root=
source_identity_path=
source_identity=
if [[ -n "$selected_runtime_version" ]]; then
  runtime_source_root=$launcher_data_root/runtimes/$selected_runtime_version/source
  source_identity_path=$launcher_data_root/runtimes/$selected_runtime_version/source.identity
  if [[ -r "$source_identity_path" ]]; then
    IFS= read -r source_identity < "$source_identity_path" || source_identity=
  fi
fi
source_identity_version=${source_identity%% *}
source_identity_sha256=${source_identity#* }
tracked_source_sha256=
if [[ "$selected_runtime_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ &&
      -r "$source_checksums_path" ]]; then
  source_archive_name=sbcl-$selected_runtime_version-source.tar.bz2
  tracked_source_sha256=$(awk -v archive_name="$source_archive_name" \
    '$2 == archive_name { print $1 }' "$source_checksums_path")
fi
if [[ "$inherited_runtime_source_root" == /* &&
      -f "$inherited_runtime_source_root/version.lisp-expr" ]] &&
   { [[ -z "$selected_runtime_version" ]] ||
     grep -Fx "\"$selected_runtime_version\"" \
       "$inherited_runtime_source_root/version.lisp-expr" >/dev/null; }; then
  export AUTOLITH_SBCL_SOURCE_ROOT=$inherited_runtime_source_root
elif [[ -n "$runtime_source_root" &&
      -n "$tracked_source_sha256" &&
      "$source_identity_version" == "$selected_runtime_version" &&
      "$source_identity_sha256" == "$tracked_source_sha256" &&
      -f "$runtime_source_root/version.lisp-expr" ]] &&
   grep -Fx "\"$source_identity_version\"" \
     "$runtime_source_root/version.lisp-expr" >/dev/null; then
  export AUTOLITH_SBCL_SOURCE_ROOT=$runtime_source_root
else
  unset AUTOLITH_SBCL_SOURCE_ROOT
fi
recovery_core=${AUTOLITH_RECOVERY_CORE:-$launcher_data_root/recovery/autolith-recovery.core}
recovery_manifest=$(dirname -- "$recovery_core")/manifest.sexp
active_core=${AUTOLITH_ACTIVE_CORE:-$launcher_data_root/active/autolith-active.core}
active_manifest=$(dirname -- "$active_core")/manifest.sexp
crash_pointer=
recovery_session_pointer=
broker_directory=
broker_socket=
broker_pid=
approval_directory=
approval_socket=
terminal_relay=
agent_temporary_directory=

if [[ -t 0 ]]; then
  terminal_state=$(stty -g 2>/dev/null || true)
fi

launcher_brand=
launcher_dim=
launcher_notice=
launcher_failure=
launcher_reset=
if [[ -t 2 && -z ${NO_COLOR:-} ]]; then
  launcher_brand=$'\033[35;1m'
  launcher_dim=$'\033[2m'
  launcher_notice=$'\033[33m'
  launcher_failure=$'\033[31;1m'
  launcher_reset=$'\033[0m'
fi

restore_terminal()
{
  if [[ -n "$terminal_state" && -t 0 ]]; then
    stty "$terminal_state" 2>/dev/null || true
    printf '\033[?2004l\033[?25h\033[0m' > /dev/tty 2>/dev/null || true
  fi
}

finish_launcher()
{
  restore_terminal
  if [[ -n "$broker_pid" ]]; then
    kill "$broker_pid" 2>/dev/null || true
    wait "$broker_pid" 2>/dev/null || true
    broker_pid=
  fi
  if [[ -n "$broker_directory" ]]; then
    rm -f -- "$broker_socket"
    rmdir -- "$broker_directory" 2>/dev/null || true
    broker_directory=
    broker_socket=
  fi
  if [[ -n "$approval_directory" ]]; then
    rm -f -- "$approval_socket"
    rmdir -- "$approval_directory" 2>/dev/null || true
    approval_directory=
    approval_socket=
  fi
  if [[ -n "$crash_pointer" ]]; then
    rm -f -- "$crash_pointer"
  fi
  if [[ -n "$recovery_session_pointer" ]]; then
    rm -f -- "$recovery_session_pointer"
  fi
  if [[ -n "$agent_temporary_directory" ]]; then
    rm -rf -- "$agent_temporary_directory"
    agent_temporary_directory=
  fi
}

start_terminal_approval()
{
  if [[ -t 0 && -t 1 && -z "$approval_socket" ]]; then
    mkdir -p -- "$state_home/autolith-launcher/approval" || return 64
    chmod 700 "$state_home/autolith-launcher" \
      "$state_home/autolith-launcher/approval" || return 64
    approval_directory=$(mktemp -d \
      "$state_home/autolith-launcher/approval/session.XXXXXX") || return 64
    chmod 700 "$approval_directory" || return 64
    approval_socket=$approval_directory/control.sock
    export AUTOLITH_BROKER_APPROVAL_SOCKET=$approval_socket
  fi
}

start_broker()
{
  local attempt

  if [[ -n "$broker_pid" ]]; then
    kill -0 "$broker_pid" 2>/dev/null && [[ -S "$broker_socket" ]]
    return $?
  fi
  mkdir -p -- "$state_home/autolith-launcher/broker" || return 64
  chmod 700 "$state_home/autolith-launcher" \
    "$state_home/autolith-launcher/broker" || return 64
  broker_directory=$(mktemp -d \
    "$state_home/autolith-launcher/broker/session.XXXXXX") || return 64
  chmod 700 "$broker_directory" || return 64
  broker_socket=$broker_directory/broker.sock
  export AUTOLITH_BROKER_CAPABILITY
  AUTOLITH_BROKER_CAPABILITY=$(od -An -tx1 -N32 /dev/urandom | tr -d '[:space:]') || return 64
  [[ ${#AUTOLITH_BROKER_CAPABILITY} -eq 64 ]] || return 64
  start_terminal_approval || return 64
  run_trusted_source --autolith-internal-broker "$broker_socket" \
    </dev/null >/dev/null 2>&1 &
  broker_pid=$!
  for ((attempt=0; attempt<300; attempt++)); do
    if [[ -S "$broker_socket" ]] && kill -0 "$broker_pid" 2>/dev/null; then
      export AUTOLITH_BROKER_SOCKET="$broker_socket"
      return 0
    fi
    if ! kill -0 "$broker_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  printf '%sAutolith could not start its credential broker.%s\n' \
    "$launcher_failure" "$launcher_reset" >&2
  return 64
}

run_trusted_source()
{
  local trusted_cache=$cache_home/autolith-launcher/trusted-source
  local relay=()

  # Nix source timestamps are fixed, so a shared output path can retain FASLs
  # from an older package. Keep each immutable source closure's cache separate.
  case $source_root in
    /nix/store/*) trusted_cache=$trusted_cache/${source_root##*/} ;;
  esac

  mkdir -p -- "$trusted_cache/asdf" || return 64
  chmod 700 "$cache_home/autolith-launcher" "$trusted_cache" || return 64
  if [[ ${1:-} == --autolith-internal-client && -n "$approval_socket" ]]; then
    relay=("$terminal_relay" "$approval_socket" --)
  fi
  env -u AUTOLITH_PROJECT_SETUP -u ASDF_OUTPUT_TRANSLATIONS \
    -u CL_SOURCE_REGISTRY \
    AUTOLITH_CLIENT_CACHE_HOME="$cache_home" \
    AUTOLITH_CLIENT_ASDF_CACHE="${AUTOLITH_ASDF_CACHE:-}" \
    XDG_CACHE_HOME="$trusted_cache" \
    AUTOLITH_ASDF_CACHE="$trusted_cache/asdf" \
    ${relay[@]+"${relay[@]}"} \
    "$sbcl_command" --script "$source_root/bin/autolith-active" "$@"
}

ensure_terminal_relay()
{
  local staged

  if [[ -n ${AUTOLITH_TERMINAL_RELAY:-} ]]; then
    [[ -x "$AUTOLITH_TERMINAL_RELAY" ]] || return 64
    terminal_relay=$AUTOLITH_TERMINAL_RELAY
    return 0
  fi
  terminal_relay=$launcher_data_root/helpers/terminal-relay
  [[ ! -L "$launcher_data_root/helpers" && ! -L "$terminal_relay" ]] || return 64
  mkdir -p -- "$launcher_data_root/helpers" || return 64
  chmod 700 "$launcher_data_root/helpers" || return 64
  if [[ -x "$terminal_relay" &&
        "$terminal_relay" -nt "$source_root/native/terminal-relay.c" ]]; then
    return 0
  fi
  staged=$(mktemp "$launcher_data_root/helpers/.terminal-relay.XXXXXX") || return 64
  if [[ $(uname -s) == Linux ]]; then
    /usr/bin/cc -std=c11 -Wall -Wextra -Werror -O2 \
      "$source_root/native/terminal-relay.c" -lutil -o "$staged" || {
        rm -f -- "$staged"
        return 64
      }
  else
    /usr/bin/cc -std=c11 -Wall -Wextra -Werror -O2 \
      "$source_root/native/terminal-relay.c" -o "$staged" || {
        rm -f -- "$staged"
        return 64
      }
  fi
  chmod 700 "$staged" || return 64
  mv -f -- "$staged" "$terminal_relay" || return 64
}

run_recovery()
{
  if [[ -f "$recovery_core" && -f "$recovery_manifest" ]] &&
     grep -Eq '^\(:RECOVERY-IMAGE :VERSION 3([[:space:]]|$)' "$recovery_manifest" &&
     "$sbcl_command" --noinform --core "$recovery_core" \
       --end-runtime-options "$source_root" --probe >/dev/null 2>&1; then
    "$sbcl_command" --noinform --core "$recovery_core" \
      --end-runtime-options "$source_root" "$@"
  else
    printf '%sPristine recovery image is missing or invalid; using source bootstrap.%s %sRun ./script/build-recovery to replace it.%s\n' \
      "$launcher_notice" "$launcher_reset" "$launcher_dim" "$launcher_reset" >&2
    "$sbcl_command" --script "$source_root/recovery/launcher.lisp" \
      "$source_root" "$@"
  fi
}

active_image_valid()
{
  [[ -f "$active_core" && -f "$active_manifest" ]] &&
     grep -Eq '^\(:ACTIVE-IMAGE :VERSION 1([[:space:]]|$)' "$active_manifest" &&
     "$sbcl_command" --noinform --core "$active_core" \
       --end-runtime-options "$source_root" \
       --autolith-internal-active-image-probe >/dev/null 2>&1
}

# Run one agent process inside the agent sandbox, which the pristine recovery
# image computes: the agent may modify itself, so what confines it must not be
# part of it. A launcher already inside the sandbox, as a detached session's
# is, runs the process directly, and AUTOLITH_AGENT_SANDBOX=off disables it.
# A sandbox that cannot start is a setup failure, status 64, not a crash for
# recovery to handle.
run_agent()
{
  local plan
  local argument
  local launcher_terminal
  local wrapped=()

  case ${AUTOLITH_AGENT_SANDBOX:-} in
    active|off)
      "$@"
      return $?
      ;;
  esac
  if [[ -z "$agent_temporary_directory" ]]; then
    agent_temporary_directory=$(mktemp -d /tmp/autolith-agent.XXXXXX) || return 64
    chmod 700 "$agent_temporary_directory" || return 64
    export AUTOLITH_AGENT_TMPDIR=$agent_temporary_directory
  fi
  start_broker || return 64
  if [[ -n "$approval_socket" ]]; then
    ensure_terminal_relay || return 64
    launcher_terminal=$(tty) || return 64
    [[ "$launcher_terminal" == /dev/* ]] || return 64
    export AUTOLITH_LAUNCHER_TERMINAL=$launcher_terminal
  fi
  plan=$(mktemp "${TMPDIR:-/tmp}/autolith-sandbox.XXXXXX") || return 64
  if ! run_recovery --agent-sandbox-command "$@" > "$plan"; then
    rm -f -- "$plan"
    return 64
  fi
  while IFS= read -r -d '' argument; do
    wrapped+=("$argument")
  done < "$plan"
  rm -f -- "$plan"
  if [[ ${#wrapped[@]} -eq 0 ]]; then
    printf '%sAutolith could not start its sandbox.%s\n' \
      "$launcher_failure" "$launcher_reset" >&2
    return 64
  fi
  if [[ -n "$approval_socket" ]]; then
    AUTOLITH_AGENT_SANDBOX=active \
      "$terminal_relay" "$approval_socket" -- "${wrapped[@]}"
  else
    AUTOLITH_AGENT_SANDBOX=active "${wrapped[@]}"
  fi
}

run_active_core()
{
  run_agent "$sbcl_command" --noinform --core "$active_core" \
    --end-runtime-options "$source_root" "$@"
}

run_active_source()
{
  run_agent "$sbcl_command" --script "$source_root/bin/autolith-active" "$@"
}

refresh_runtime_command()
{
  local installed_runtime=

  if [[ -r "$runtime_command_path" ]]; then
    IFS= read -r installed_runtime < "$runtime_command_path" || installed_runtime=
  fi
  if [[ "$installed_runtime" == /* && -x "$installed_runtime" ]]; then
    sbcl_command=$installed_runtime
    export AUTOLITH_SBCL=$sbcl_command
  fi
}

bootstrap_active_image()
{
  local bootstrap_status

  if [[ -n "$configured_sbcl" ]]; then
    AUTOLITH_SBCL="$configured_sbcl" "$source_root/script/bootstrap"
  else
    env -u AUTOLITH_SBCL "$source_root/script/bootstrap"
  fi
  bootstrap_status=$?
  if [[ "$bootstrap_status" -ne 0 ]]; then
    printf '%sAutolith bootstrap failed with status %d.%s\n' \
      "$launcher_failure" "$bootstrap_status" "$launcher_reset" >&2
    return 64
  fi
  refresh_runtime_command
  if ! active_image_valid; then
    printf '%sAutolith bootstrap completed without a usable fast startup image.%s\n' \
      "$launcher_failure" "$launcher_reset" >&2
    return 64
  fi
  return 0
}

offer_bootstrap()
{
  local answer=

  while true; do
    printf '%sAutolith%s fast startup image is missing or stale. Run %s"%s/script/bootstrap"%s now? [Y/n] ' \
      "$launcher_brand" "$launcher_reset" \
      "$launcher_dim" "$source_root" "$launcher_reset" >&2
    if ! IFS= read -r answer; then
      answer=n
    fi
    case "$answer" in
      ''|y|Y|yes|YES|Yes)
        bootstrap_active_image
        return $?
        ;;
      n|N|no|NO|No)
        return 1
        ;;
      *)
        printf '%sPlease answer yes or no.%s\n' \
          "$launcher_dim" "$launcher_reset" >&2
        ;;
    esac
  done
}

run_active()
{
  local client_status

  export AUTOLITH_SOURCE_ROOT="$source_root"
  # Spawn detached sessions before entering the agent sandbox. The thin client
  # loads tracked source only; each session's launcher owns its broker and sandbox.
  if [[ -t 0 && -t 1 && ${AUTOLITH_AGENT_SANDBOX:-} != active &&
        ${AUTOLITH_SESSION_STYLE:-} != direct ]]; then
    if [[ ${AUTOLITH_AGENT_SANDBOX:-} != off ]]; then
      start_terminal_approval || return 64
      ensure_terminal_relay || return 64
      export AUTOLITH_LAUNCHER_TERMINAL
      AUTOLITH_LAUNCHER_TERMINAL=$(tty) || return 64
    fi
    run_trusted_source --autolith-internal-client "$@"
    client_status=$?
    if [[ "$client_status" -ne 125 ]]; then
      return "$client_status"
    fi
  fi
  if [[ "$from_source_requested" == true ]]; then
    run_active_source "$@"
  elif active_image_valid; then
    run_active_core "$@"
  elif [[ -t 0 && -t 2 ]]; then
    if offer_bootstrap; then
      run_active_core "$@"
    else
      status=$?
      if [[ "$status" -eq 64 ]]; then
        return 64
      fi
      printf '%sLoading Autolith from source.%s\n' \
        "$launcher_dim" "$launcher_reset" >&2
      run_active_source "$@"
    fi
  else
    run_active_source "$@"
  fi
}

trap finish_launcher EXIT HUP INT TERM

if [[ "$recovery_requested" == true ]]; then
  restore_terminal
  run_recovery ${remaining_arguments[@]+"${remaining_arguments[@]}"}
  exit $?
fi

if [[ ${remaining_arguments[0]:-} == auth ]]; then
  if [[ ${#remaining_arguments[@]} -gt 3 ]]; then
    printf 'Usage: autolith auth [PROVIDER] [METHOD]\n' >&2
    exit 64
  fi
  run_trusted_source \
    --autolith-internal-auth "${remaining_arguments[@]:1}" || exit $?
  remaining_arguments=()
fi

crash_pointer_directory="$state_home/autolith/crash-pointers"
mkdir -p -- "$crash_pointer_directory"
chmod 700 "$crash_pointer_directory"
crash_pointer="$crash_pointer_directory/launcher-$$.path"
rm -f -- "$crash_pointer"
export AUTOLITH_CRASH_POINTER="$crash_pointer"

recovery_session_pointer_directory="$state_home/autolith/recovery-session-pointers"
mkdir -p -- "$recovery_session_pointer_directory"
chmod 700 "$recovery_session_pointer_directory"
recovery_session_pointer="$recovery_session_pointer_directory/launcher-$$.sexp"
rm -f -- "$recovery_session_pointer"
export AUTOLITH_RECOVERY_SESSION_POINTER="$recovery_session_pointer"

if run_active ${remaining_arguments[@]+"${remaining_arguments[@]}"}; then
  exit 0
else
  status=$?
fi

restore_terminal

if [[ "$data_requested" == true ]]; then
  exit "$status"
fi

if [[ "$status" -ne 64 && "$status" -ne 76 &&
      "$status" -ne 130 && "$status" -ne 143 ]]; then
  capsule=
  if [[ -f "$crash_pointer" ]]; then
    IFS= read -r capsule < "$crash_pointer" || capsule=
    case "$capsule" in
      "$state_home/autolith/crashes/"*.sexp)
        if [[ ! -f "$capsule" ]]; then
          capsule=
        fi
        ;;
      *)
        capsule=
        ;;
    esac
  fi
  recovery_arguments=("--status" "$status")
  if [[ -n "$capsule" ]]; then
    recovery_arguments+=("--capsule" "$capsule")
  fi
  for argument in ${remaining_arguments[@]+"${remaining_arguments[@]}"}; do
    recovery_arguments+=("--original-argument" "$argument")
  done
  recovery_arguments+=("--" ${remaining_arguments[@]+"${remaining_arguments[@]}"})
  run_recovery "${recovery_arguments[@]}"
  exit $?
fi

exit "$status"
