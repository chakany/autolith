#!/usr/bin/env -S sbcl --script

(require :asdf)

(let* ((launcher-path (truename *load-truename*))
       (bin-directory (uiop:pathname-directory-pathname launcher-path))
       (source-root (uiop:pathname-parent-directory-pathname bin-directory))
       (project-setup
         (or (let ((override (uiop:getenv "AUTOLITH_PROJECT_SETUP")))
               (and override (plusp (length override)) (pathname override)))
             (merge-pathnames ".qlot/setup.lisp" source-root)))
       (user-setup (merge-pathnames "quicklisp/setup.lisp"
                                    (user-homedir-pathname)))
       (quicklisp-setup (if (probe-file project-setup)
                           project-setup
                           user-setup)))
  (asdf:initialize-source-registry
   `(:source-registry (:tree ,(namestring source-root))
                      :inherit-configuration))
  (cond
    ((probe-file quicklisp-setup)
     (load quicklisp-setup))
    ((not (equal (uiop:getenv "AUTOLITH_INSTALLATION_KIND") "nix"))
     (error "Autolith needs Quicklisp at ~A" quicklisp-setup)))
  (asdf:load-system :cffi)
  (let ((profile-library-directory
          (merge-pathnames ".guix-profile/lib/" (user-homedir-pathname)))
        (library-directories
          (find-symbol "*FOREIGN-LIBRARY-DIRECTORIES*" "CFFI")))
    (when (probe-file profile-library-directory)
      (pushnew profile-library-directory
               (symbol-value library-directories)
               :test #'equal)))
  (asdf:clear-system :autolith)
  (asdf:load-asd (merge-pathnames "autolith.asd" source-root))
  (asdf:load-system :autolith)
  (let ((arguments (uiop:command-line-arguments)))
    (cond
      ((and arguments
            (string= (first arguments) "--autolith-internal-client"))
       (uiop:symbol-call '#:autolith '#:main-launcher-client (rest arguments)))
      ((and (= (length arguments) 2)
            (string= (first arguments) "--autolith-internal-broker"))
       (funcall (symbol-function (find-symbol "BROKER-RUN" '#:autolith))
                (pathname (second arguments))))
      ((and (<= 1 (length arguments) 3)
            (string= (first arguments) "--autolith-internal-auth"))
       (funcall (symbol-function
                 (find-symbol "BROKER-AUTHENTICATE" '#:autolith))
                (second arguments) (third arguments)))
      (t
       (uiop:symbol-call '#:autolith '#:main arguments)))))
