#!/usr/bin/env bash

set -euo pipefail

resolve_path()
{
  local path=$1
  local directory
  local target

  case "$path" in
    /*) ;;
    *) path=$PWD/$path ;;
  esac
  while [[ -L "$path" ]]; do
    directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    case "$target" in
      /*) path=$target ;;
      *) path=$directory/$target ;;
    esac
  done
  directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd) || return 1
  printf '%s/%s\n' "$directory" "$(basename "$path")"
}

ensure_sha256sum()
{
  local gsha

  if command -v sha256sum >/dev/null 2>&1; then
    return 0
  fi
  gsha=$(command -v gsha256sum || true)
  if [[ -z $gsha ]]; then
    return 0
  fi
  mkdir -p "$HOME/bin"
  ln -sf "$gsha" "$HOME/bin/sha256sum"
  export PATH="$HOME/bin:$PATH"
}

ensure_gnu_tar()
{
  case $(uname -s) in
    Linux)
      return 0
      ;;
  esac
  if command -v gtar >/dev/null 2>&1 || command -v gnutar >/dev/null 2>&1; then
    return 0
  fi
  if [[ -x /usr/local/bin/gtar || -x /usr/pkg/bin/gtar || -x /opt/local/bin/gtar ]]; then
    return 0
  fi
  case $(uname -s) in
    OpenBSD)
      if command -v pkg_add >/dev/null 2>&1; then
        pkg_add gtar-- || pkg_add gtar-1.35p1 || true
      fi
      ;;
    *)
      if command -v pkg_add >/dev/null 2>&1; then
        pkg_add gtar || true
      elif command -v pkgin >/dev/null 2>&1; then
        pkgin -y install gtar || true
      fi
      ;;
  esac
  if command -v gtar >/dev/null 2>&1 || command -v gnutar >/dev/null 2>&1; then
    return 0
  fi
  if [[ -x /usr/local/bin/gtar || -x /usr/pkg/bin/gtar || -x /opt/local/bin/gtar ]]; then
    return 0
  fi
  printf 'GNU tar (gtar) is required for reproducible release archives.\n' >&2
  exit 1
}

launcher_path=$(resolve_path "${BASH_SOURCE[0]}")
source_root=$(CDPATH= cd -P -- "$(dirname -- "$launcher_path")/.." && pwd)
output_directory=${1:-dist/}

cd "$source_root"
if [[ $(uname -s) == OpenBSD && ${HOME:-} == /root ]]; then
  export HOME=/tmp/autolith-home
  mkdir -p "$HOME"
fi
export PATH="$HOME/bin:/usr/local/bin:/usr/pkg/bin:$PATH"
ensure_sha256sum
ensure_gnu_tar

static_musl=false
if [[ $(uname -s) == Linux ]] && command -v ldd >/dev/null 2>&1 &&
   grep -iq musl <<< "$(ldd /bin/sh 2>&1 || true)"; then
  static_musl=true
  export AUTOLITH_STATIC_MUSL=1
  export AUTOLITH_BUILD_STATIC_NATIVE=1
fi

runtime_version=$(tr -d '[:space:]' < sbcl.version)
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
runtime_root=$data_home/autolith/runtimes/$runtime_version
runtime_sbcl=$runtime_root/installation/bin/sbcl
runtime_static_archive=$runtime_root/static-build/libsbcl.a
runtime_builder=$runtime_root/static-build/installation/bin/sbcl

if [[ ! -x $runtime_sbcl ||
      ($static_musl == true &&
       (! -f $runtime_static_archive || ! -x $runtime_builder)) ]]; then
  printf 'Building the pinned SBCL release runtime.\n'
  rm -rf -- "$runtime_root/installation" "$runtime_root/static-build"
  mkdir -p "$runtime_root"
  ./script/build-release-runtime "$runtime_root/installation"
fi

bootstrap_sbcl=$runtime_sbcl
if [[ $static_musl == true ]]; then
  bootstrap_sbcl=$runtime_builder
fi

if [[ ! -f $HOME/quicklisp/setup.lisp ]]; then
  temporary_root=$(mktemp -d)
  cleanup()
  {
    rm -rf -- "$temporary_root"
  }
  trap cleanup EXIT HUP INT TERM
  printf 'Installing Quicklisp.\n'
  curl --fail --location --show-error --retry 3 \
    --proto '=https' --tlsv1.2 \
    --output "$temporary_root/quicklisp.lisp" \
    https://beta.quicklisp.org/quicklisp.lisp
  "$bootstrap_sbcl" --noinform --no-userinit --no-sysinit --non-interactive \
    --load "$temporary_root/quicklisp.lisp" \
    --eval '(quicklisp-quickstart:install :path (merge-pathnames "quicklisp/" (user-homedir-pathname)))'
  cleanup
  trap - EXIT HUP INT TERM
fi

printf 'Bootstrapping Autolith dependencies.\n'
AUTOLITH_SBCL=$bootstrap_sbcl ./script/bootstrap
if [[ $static_musl == true ]]; then
  printf 'Linking the static musl runtime and native helper.\n'
  ./script/build-static-release-runtime "$runtime_root/installation"
fi
printf 'Building the release archive.\n'
./script/build-release "$output_directory"
