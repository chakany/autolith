#!/usr/bin/env bash

set -euo pipefail

resolve_path()
{
  local path=$1
  local directory
  local target

  case "$path" in
    /*) ;;
    *) path=$PWD/$path ;;
  esac
  while [[ -L "$path" ]]; do
    directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    case "$target" in
      /*) path=$target ;;
      *) path=$directory/$target ;;
    esac
  done
  directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd) || return 1
  printf '%s/%s\n' "$directory" "$(basename "$path")"
}

launcher_path=$(resolve_path "${BASH_SOURCE[0]}")
source_root=$(CDPATH= cd -P "$(dirname "$launcher_path")/.." && pwd)

constant_pattern='^[[:space:]]*\([[:space:]]*([^[:space:]()]+:)?(define-constant|defconstant)([[:space:]()]|$)'

set +e
constant_matches=$(
  grep -r -n -I -i -E \
    --include='*.lisp' \
    --include='autolith.asd' \
    "$constant_pattern" \
    "$source_root/autolith.asd" \
    "$source_root/src" \
    "$source_root/recovery" \
    "$source_root/server" \
    "$source_root/script" \
    "$source_root/tests" 2>&1
)
constant_status=$?
set -e

case "$constant_status" in
  0)
    printf '%s\n' \
      'Autolith source must not declare constants:' \
      "$constant_matches" >&2
    exit 1
    ;;
  1)
    ;;
  *)
    printf '%s\n' \
      'Could not inspect Autolith source for constant declarations:' \
      "$constant_matches" >&2
    exit "$constant_status"
    ;;
esac

exec "$source_root/bin/autolith-runtime" \
  --script "$source_root/script/check.lisp" "$@"
