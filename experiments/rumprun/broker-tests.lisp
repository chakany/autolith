;;;; Host tests for the broker's RPC and NFS services.
;;;; Run with sbcl --script experiments/rumprun/broker-tests.lisp.
(require :asdf)
(require :sb-posix)
(require :sb-bsd-sockets)
(load (merge-pathnames "broker-rpc.lisp" *load-truename*))
(load (merge-pathnames "broker-nfs.lisp" *load-truename*))
(in-package #:autolith)

(defvar *broker-test-checks* 0
  "The number of checks that passed.")

(defun broker-test-check (value description)
  "Fail unless VALUE is true, naming DESCRIPTION."
  (unless value
    (error "Broker check failed: ~A" description))
  (incf *broker-test-checks*))

(defun broker-test-signals-p (condition-type function)
  "Return true when FUNCTION signals a condition of CONDITION-TYPE."
  (handler-case (progn (funcall function) nil)
    (condition (condition)
      (typep condition condition-type))))


;;;; -- A Minimal NFS Client --

(defvar *broker-test-xid* 0
  "The last transaction identifier used.")

(defun broker-test-call (program procedure encode &key (version 3) (uid 501) (gid 20))
  "Return the octets of a call to PROCEDURE of PROGRAM whose arguments ENCODE
appends to a writer, with an AUTH_SYS credential for UID and GID."
  (let ((writer (xdr-writer-create))
        (body   (xdr-writer-create)))
    (xdr-write-unsigned body 0)
    (xdr-write-string body "test")
    (xdr-write-unsigned body uid)
    (xdr-write-unsigned body gid)
    (xdr-write-unsigned body 0)
    (xdr-write-unsigned writer (incf *broker-test-xid*))
    (xdr-write-unsigned writer *rpc-message-call*)
    (xdr-write-unsigned writer 2)
    (xdr-write-unsigned writer program)
    (xdr-write-unsigned writer version)
    (xdr-write-unsigned writer procedure)
    (xdr-write-unsigned writer *rpc-authentication-unix*)
    (xdr-write-opaque writer (xdr-writer->octets body))
    (xdr-write-unsigned writer *rpc-authentication-none*)
    (xdr-write-unsigned writer 0)
    (funcall encode writer)
    (xdr-writer->octets writer)))

(defun broker-test-reply (server octets)
  "Dispatch call OCTETS to SERVER and return the accept status and a reader
positioned at the results."
  (let ((reader (xdr-reader-create (nfs-server-dispatch server octets))))
    (broker-test-check (= (xdr-read-unsigned reader) *broker-test-xid*) "replies echo the xid")
    (broker-test-check (= (xdr-read-unsigned reader) *rpc-message-reply*) "replies are replies")
    (broker-test-check (= (xdr-read-unsigned reader) *rpc-reply-accepted*) "calls are accepted")
    (xdr-read-unsigned reader)
    (xdr-read-opaque reader *rpc-maximum-authentication*)
    (values (xdr-read-unsigned reader) reader)))

(defun broker-test-nfs (server procedure encode)
  "Call NFS PROCEDURE on SERVER and return its status and a results reader."
  (multiple-value-bind (accept reader)
      (broker-test-reply server (broker-test-call *nfs-program* procedure encode))
    (broker-test-check (= accept *rpc-accept-success*) "NFS calls succeed at the RPC level")
    (values (xdr-read-unsigned reader) reader)))

(defun broker-test-skip-attributes (reader)
  "Skip one post_op_attr in READER and return the fattr3 type and size, or NIL."
  (when (xdr-read-boolean reader)
    (let ((type (xdr-read-unsigned reader)))
      (dotimes (index 4) (xdr-read-unsigned reader))
      (let ((size (xdr-read-hyper reader)))
        (xdr-read-hyper reader)
        (dotimes (index 2) (xdr-read-unsigned reader))
        (dotimes (index 2) (xdr-read-hyper reader))
        (dotimes (index 6) (xdr-read-unsigned reader))
        (values type size)))))

(defun broker-test-mount (server name)
  "Return the MNT status for export NAME and, on success, its root handle."
  (multiple-value-bind (accept reader)
      (broker-test-reply server (broker-test-call *nfs-mount-program* 1
                                                  (lambda (writer) (xdr-write-string writer name))))
    (broker-test-check (= accept *rpc-accept-success*) "MNT succeeds at the RPC level")
    (let ((status (xdr-read-unsigned reader)))
      (values status (and (zerop status) (xdr-read-opaque reader 64))))))

(defun broker-test-lookup (server directory name)
  "Return the LOOKUP status of NAME in DIRECTORY and, on success, its handle."
  (multiple-value-bind (status reader)
      (broker-test-nfs server 3 (lambda (writer)
                                  (xdr-write-opaque writer directory)
                                  (xdr-write-string writer name)))
    (values status (and (zerop status) (xdr-read-opaque reader 64)))))

(defun broker-test-create (server directory name)
  "Create file NAME in DIRECTORY unchecked and return its status and handle."
  (multiple-value-bind (status reader)
      (broker-test-nfs server 8 (lambda (writer)
                                  (xdr-write-opaque writer directory)
                                  (xdr-write-string writer name)
                                  (xdr-write-unsigned writer 0)
                                  (dotimes (index 6) (xdr-write-boolean writer nil))))
    (values status (and (zerop status) (xdr-read-boolean reader) (xdr-read-opaque reader 64)))))

(defun broker-test-write (server file offset octets)
  "Write OCTETS to FILE at OFFSET and return the status."
  (broker-test-nfs server 7 (lambda (writer)
                              (xdr-write-opaque writer file)
                              (xdr-write-hyper writer offset)
                              (xdr-write-unsigned writer (length octets))
                              (xdr-write-unsigned writer 2)
                              (xdr-write-opaque writer octets))))

(defun broker-test-read (server file offset count)
  "Return the READ status of FILE and, on success, the data and EOF flag."
  (multiple-value-bind (status reader)
      (broker-test-nfs server 6 (lambda (writer)
                                  (xdr-write-opaque writer file)
                                  (xdr-write-hyper writer offset)
                                  (xdr-write-unsigned writer count)))
    (if (zerop status)
        (progn (broker-test-skip-attributes reader)
               (xdr-read-unsigned reader)
               (let ((eof (xdr-read-boolean reader)))
                 (values status (xdr-read-opaque reader *nfs-transfer-size*) eof)))
        status)))

(defun broker-test-readdir-names (server directory count)
  "Return every name READDIR lists in DIRECTORY, paging with COUNT-octet
replies."
  (let ((names    nil)
        (cookie   0)
        (verifier (make-array 8 :element-type '(unsigned-byte 8) :initial-element 0)))
    (loop
      (multiple-value-bind (status reader)
          (broker-test-nfs server 16 (lambda (writer)
                                       (xdr-write-opaque writer directory)
                                       (xdr-write-hyper writer cookie)
                                       (xdr-write-fixed-opaque writer verifier)
                                       (xdr-write-unsigned writer count)))
        (broker-test-check (zerop status) "READDIR succeeds")
        (broker-test-skip-attributes reader)
        (setf verifier (xdr-read-fixed-opaque reader 8))
        (loop while (xdr-read-boolean reader)
              do (xdr-read-hyper reader)
                 (push (xdr-read-string reader 255) names)
                 (setf cookie (xdr-read-hyper reader)))
        (when (xdr-read-boolean reader)
          (return (nreverse names)))))))

(defun broker-test-mtime (server file)
  "Return FILE's modification time as seconds and nanoseconds from GETATTR."
  (multiple-value-bind (status reader)
      (broker-test-nfs server 1 (lambda (writer) (xdr-write-opaque writer file)))
    (broker-test-check (zerop status) "GETATTR succeeds")
    (dotimes (index 5) (xdr-read-unsigned reader))
    (dotimes (index 2) (xdr-read-hyper reader))
    (dotimes (index 2) (xdr-read-unsigned reader))
    (dotimes (index 2) (xdr-read-hyper reader))
    (dotimes (index 2) (xdr-read-unsigned reader))
    (list (xdr-read-unsigned reader) (xdr-read-unsigned reader))))

(defun broker-test-octets (text)
  "Return TEXT as UTF-8 octets."
  (sb-ext:string-to-octets text :external-format ':utf-8))


;;;; -- Tests --

(defun broker-test-rpc ()
  "Check XDR encoding and record marking, including fail-closed bounds."
  (let ((writer (xdr-writer-create)))
    (xdr-write-unsigned writer #xdeadbeef)
    (xdr-write-signed writer -2)
    (xdr-write-hyper writer (ash 1 40))
    (xdr-write-string writer "λx")
    (xdr-write-boolean writer t)
    (let ((reader (xdr-reader-create (xdr-writer->octets writer))))
      (broker-test-check (= (xdr-read-unsigned reader) #xdeadbeef) "unsigned round trip")
      (broker-test-check (= (xdr-read-signed reader) -2) "signed round trip")
      (broker-test-check (= (xdr-read-hyper reader) (ash 1 40)) "hyper round trip")
      (broker-test-check (string= (xdr-read-string reader 16) "λx") "UTF-8 string round trip")
      (broker-test-check (xdr-read-boolean reader) "boolean round trip")
      (broker-test-check (xdr-reader-finished-p reader) "strings are padded to four octets")))
  (flet ((reader-of (octets) (xdr-reader-create (coerce octets '(simple-array (unsigned-byte 8) (*))))))
    (broker-test-check (broker-test-signals-p 'xdr-error (lambda () (xdr-read-unsigned (reader-of #(1 2)))))
                       "a truncated integer is rejected")
    (broker-test-check (broker-test-signals-p 'xdr-error
                                              (lambda () (xdr-read-opaque (reader-of #(0 0 1 0)) 16)))
                       "opaque data longer than its bound is rejected before allocation")
    (broker-test-check (broker-test-signals-p 'xdr-error (lambda () (xdr-read-boolean (reader-of #(0 0 0 2)))))
                       "a boolean other than zero or one is rejected"))
  (flet ((stream-of (octets) (broker-test-input-stream octets)))
    (let ((two-fragments (concatenate '(vector (unsigned-byte 8))
                                      #(0 0 0 2 1 2) #(128 0 0 1 3))))
      (broker-test-check (equalp (rpc-read-record (stream-of two-fragments)) #(1 2 3))
                         "fragments join into one record"))
    (broker-test-check (null (rpc-read-record (stream-of #()))) "a clean end of stream ends records")
    (broker-test-check (broker-test-signals-p 'xdr-error (lambda () (rpc-read-record (stream-of #(128 0 0 4 1)))))
                       "a truncated record is rejected")
    (broker-test-check (broker-test-signals-p 'xdr-error (lambda () (rpc-read-record (stream-of #(255 255 255 255)))))
                       "an oversized record is rejected before allocation")))

(defun broker-test-input-stream (octets)
  "Return an octet input stream over OCTETS."
  (let ((path (format nil "/tmp/broker-test-~D.bin" (random (ash 1 40) (make-random-state t)))))
    (with-open-file (out path :direction ':output :element-type '(unsigned-byte 8))
      (write-sequence (coerce octets '(vector (unsigned-byte 8))) out))
    (prog1 (open path :element-type '(unsigned-byte 8))
      (delete-file path))))

(defun broker-test-nfs-service (root outside)
  "Check the NFS service over export directory ROOT, with OUTSIDE a host
directory the guest must never reach."
  (let ((server (nfs-server-create (list (list "/workspace" root)))))
    (broker-test-check (= (broker-test-mount server "/elsewhere") *nfs-error-access*)
                       "only configured exports mount")
    (multiple-value-bind (status root-handle) (broker-test-mount server "/workspace")
      (broker-test-check (zerop status) "the export mounts")
      (multiple-value-bind (created file) (broker-test-create server root-handle "notes.txt")
        (broker-test-check (zerop created) "CREATE makes a file")
        (broker-test-check (zerop (broker-test-write server file 0 (broker-test-octets "hello nfs")))
                           "WRITE stores data")
        (multiple-value-bind (read data eof) (broker-test-read server file 6 100)
          (broker-test-check (and (zerop read) (equalp data (broker-test-octets "nfs")) eof)
                             "READ returns data from an offset with EOF"))
        (broker-test-check (string= (uiop:read-file-string (concatenate 'string root "/notes.txt"))
                                    "hello nfs")
                           "writes reach the host file")
        (let ((first (broker-test-mtime server file)))
          (broker-test-write server file 0 (broker-test-octets "hello NFS"))
          (broker-test-check (not (equal first (broker-test-mtime server file)))
                             "two writes within one second report different modification times")))
      (multiple-value-bind (status parent) (broker-test-lookup server root-handle "..")
        (broker-test-check (and (zerop status) (equalp parent root-handle))
                           ".. at the export root stays at the root"))
      (dolist (name '("" "a/b" "."))
        (broker-test-check (/= 0 (broker-test-create server root-handle name))
                           (format nil "CREATE refuses the name ~S" name)))
      (broker-test-check (= (broker-test-lookup server root-handle (make-string 300 :initial-element #\a))
                            *nfs-error-name-too-long*)
                         "overlong names are refused")
      ;; A directory replaced by a symbolic link must not lead outside, even
      ;; where the link's target has the same shape.
      (sb-posix:mkdir (concatenate 'string root "/inner") #o755)
      (sb-posix:mkdir (concatenate 'string root "/inner/deep") #o755)
      (sb-posix:mkdir (concatenate 'string outside "/deep") #o755)
      (multiple-value-bind (status inner) (broker-test-lookup server root-handle "inner")
        (broker-test-check (zerop status) "a directory is looked up")
        (multiple-value-bind (status deep) (broker-test-lookup server inner "deep")
          (broker-test-check (zerop status) "a nested directory is looked up")
          (sb-posix:rmdir (concatenate 'string root "/inner/deep"))
          (sb-posix:rmdir (concatenate 'string root "/inner"))
          (sb-posix:symlink outside (concatenate 'string root "/inner"))
          (broker-test-check (= (broker-test-lookup server inner "deep") *nfs-error-not-directory*)
                             "a handle whose directory became a symbolic link is no directory")
          (broker-test-check (= (broker-test-create server inner "planted") *nfs-error-not-directory*)
                             "nothing is created in a directory that became a link")
          (broker-test-check (= (broker-test-create server deep "planted") *nfs-error-stale*)
                             "a handle below a directory that became a link is stale")
          (broker-test-check (not (or (probe-file (concatenate 'string outside "/planted"))
                                      (probe-file (concatenate 'string outside "/deep/planted"))))
                             "the outside directory is untouched")))
      (multiple-value-bind (status link) (broker-test-lookup server root-handle "inner")
        (broker-test-check (zerop status) "a symbolic link itself is looked up")
        (multiple-value-bind (readlink reader)
            (broker-test-nfs server 5 (lambda (writer) (xdr-write-opaque writer link)))
          (broker-test-check (zerop readlink) "READLINK succeeds")
          (broker-test-skip-attributes reader)
          (broker-test-check (string= (xdr-read-string reader 1024) outside)
                             "READLINK returns the link text for the guest to resolve"))
        (broker-test-check (/= 0 (broker-test-read server link 0 10))
                           "READ never follows a symbolic link")
        (broker-test-check (= (broker-test-nfs server 15 (lambda (writer)
                                                           (xdr-write-opaque writer link)
                                                           (xdr-write-opaque writer root-handle)
                                                           (xdr-write-string writer "hard")))
                              *nfs-error-invalid*)
                           "LINK refuses a symbolic link, which some hosts would follow"))
      ;; Renaming a directory keeps handles below it usable.
      (sb-posix:mkdir (concatenate 'string root "/before") #o755)
      (multiple-value-bind (status before) (broker-test-lookup server root-handle "before")
        (declare (ignore status))
        (multiple-value-bind (created file) (broker-test-create server before "kept.txt")
          (declare (ignore created))
          (broker-test-check (zerop (broker-test-nfs server 14 (lambda (writer)
                                                                  (xdr-write-opaque writer root-handle)
                                                                  (xdr-write-string writer "before")
                                                                  (xdr-write-opaque writer root-handle)
                                                                  (xdr-write-string writer "after"))))
                             "RENAME moves a directory")
          (broker-test-check (zerop (broker-test-write server file 0 (broker-test-octets "moved")))
                             "a handle below a renamed directory still resolves")
          (broker-test-check (string= (uiop:read-file-string (concatenate 'string root "/after/kept.txt"))
                                      "moved")
                             "that handle names the file's new path")))
      ;; Directory listings page with stable cookies.
      (sb-posix:mkdir (concatenate 'string root "/many") #o755)
      (dotimes (index 40)
        (with-open-file (out (format nil "~A/many/file-~2,'0D" root index) :direction ':output)))
      (multiple-value-bind (status many) (broker-test-lookup server root-handle "many")
        (declare (ignore status))
        (let ((names (broker-test-readdir-names server many 600)))
          (broker-test-check (equal names (list* "." ".." (loop for index below 40
                                                                 collect (format nil "file-~2,'0D" index))))
                             "paged READDIR lists . .. and every entry once, in order")))
      ;; Handles are bound to one server and one size.
      (let ((other (nfs-server-create (list (list "/workspace" root)))))
        (multiple-value-bind (status foreign) (broker-test-mount other "/workspace")
          (declare (ignore status))
          (broker-test-check (= (broker-test-lookup server foreign "notes.txt") *nfs-error-stale*)
                             "another server's handle is stale")))
      (broker-test-check (= (broker-test-lookup server (subseq root-handle 0 8) "notes.txt")
                            *nfs-error-bad-handle*)
                         "a handle of the wrong size is refused")
      ;; RPC-level failures.
      (broker-test-check (= (broker-test-reply server (broker-test-call 100099 0 (lambda (writer) writer)))
                            *rpc-accept-program-unavailable*)
                         "unknown programs are unavailable")
      (broker-test-check (= (broker-test-reply server (broker-test-call *nfs-program* 0 (lambda (writer) writer)
                                                                        :version 2))
                            *rpc-accept-program-mismatch*)
                         "other NFS versions are refused")
      (broker-test-check (= (broker-test-reply server (broker-test-call *nfs-program* 3
                                                                        (lambda (writer) (xdr-write-unsigned writer 99))))
                            *rpc-accept-garbage-arguments*)
                         "undecodable arguments are garbage")
      (broker-test-check (= (broker-test-reply server (broker-test-call *nfs-program* 42 (lambda (writer) writer)))
                            *rpc-accept-procedure-unavailable*)
                         "unknown procedures are unavailable"))))

(defun broker-test-main ()
  "Run every broker test in fresh temporary directories."
  (let* ((base    (string-right-trim '(#\Newline)
                                     (uiop:run-program '("mktemp" "-d" "/tmp/broker-test.XXXXXX")
                                                       :output ':string)))
         (root    (concatenate 'string base "/export"))
         (outside (concatenate 'string base "/outside")))
    (unwind-protect
         (progn
           (sb-posix:mkdir root #o755)
           (sb-posix:mkdir outside #o755)
           (broker-test-rpc)
           (broker-test-nfs-service root outside)
           (format t "BROKER-TEST-OK ~D checks~%" *broker-test-checks*))
      (uiop:run-program (list "rm" "-rf" base)))))

(broker-test-main)
