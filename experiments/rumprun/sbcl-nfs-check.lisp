;;;; Guest checks of a host directory the broker exports over NFS, mounted
;;;; on /workspace. The host seeds hello.txt and checks the results afterward.
(require :asdf)

(defvar *checks* 0
  "The number of checks that passed.")

(defun check (value label)
  "Fail the guest on an incorrect result, reporting a completed check otherwise."
  (unless value (error "Guest NFS check failed: ~A" label))
  (incf *checks*)
  (format t "PASS ~A~%" label)
  (finish-output))

(check (with-open-file (in "/workspace/hello.txt") (string= (read-line in) "hello from the host"))
       "read a host file")
(ensure-directories-exist "/workspace/guest/nested/")
(let ((text (make-string 200000 :initial-element #\x)))
  (with-open-file (out "/workspace/guest/large.txt" :direction :output :if-exists :supersede)
    (write-string text out))
  (check (with-open-file (in "/workspace/guest/large.txt")
           (let ((copy (make-string (file-length in))))
             (read-sequence copy in)
             (string= copy text)))
         "write and read back a file larger than one transfer"))
(with-open-file (out "/workspace/guest/nested/moved-from.txt" :direction :output :if-exists :supersede)
  (write-line "renamed" out))
(rename-file "/workspace/guest/nested/moved-from.txt" "/workspace/guest/moved.txt")
(check (and (probe-file "/workspace/guest/moved.txt")
            (not (probe-file "/workspace/guest/nested/moved-from.txt")))
       "rename across directories")
(with-open-file (out "/workspace/guest/deleted.txt" :direction :output :if-exists :supersede)
  (write-line "gone" out))
(delete-file "/workspace/guest/deleted.txt")
(check (not (probe-file "/workspace/guest/deleted.txt")) "delete a file")
(check (and (equal (sort (mapcar #'file-namestring (uiop:directory-files "/workspace/guest/"))
                         #'string<)
                   '("large.txt" "moved.txt"))
            (equal (mapcar (lambda (directory) (first (last (pathname-directory directory))))
                           (uiop:subdirectories "/workspace/guest/"))
                   '("nested")))
       "list a directory")
(format t "NFS-OK ~D checks~%" *checks*)
(sb-ext:exit :code 0)
