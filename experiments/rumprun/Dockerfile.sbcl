# Repeatable SBCL 2.6.6 rumprun port build image from pinned source inputs.
FROM autolith-rumprun-probe:local

USER 0:0

RUN apt-get -o Acquire::Retries=5 update \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y \
       --no-install-recommends sbcl bzip2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY sbcl-build.lisp /probe/sbcl-build.lisp
COPY sbcl-configure.lisp /probe/sbcl-configure.lisp
COPY sbcl-runtime.lisp /probe/sbcl-runtime.lisp
COPY rumprun-os.c /probe/rumprun-os.c
COPY rumprun-mounts.c /probe/rumprun-mounts.c
COPY rumprun-mounts.h /probe/rumprun-mounts.h
COPY sbcl-link.lisp /probe/sbcl-link.lisp
COPY sbcl-machine.c /probe/sbcl-machine.c
COPY sbcl-machine.h /probe/sbcl-machine.h
COPY sbcl-process.c /probe/sbcl-process.c
COPY sbcl-traps.S /probe/sbcl-traps.S
COPY sbcl-machine-test.c /probe/sbcl-machine-test.c
COPY sbcl-clock.c /probe/sbcl-clock.c
COPY sbcl-clock-test.c /probe/sbcl-clock-test.c
COPY sbcl-warm-compile.lisp /probe/sbcl-warm-compile.lisp
COPY sbcl-warm.lisp /probe/sbcl-warm.lisp
COPY sbcl-contribs.lisp /probe/sbcl-contribs.lisp
COPY sbcl-grovel-main.c /probe/sbcl-grovel-main.c
COPY sbcl-smoke.lisp /probe/sbcl-smoke.lisp
COPY sbcl-nfs-check.lisp /probe/sbcl-nfs-check.lisp
COPY sbcl-process-check.lisp /probe/sbcl-process-check.lisp
COPY broker-rpc.lisp /probe/broker-rpc.lisp
COPY broker-nfs.lisp /probe/broker-nfs.lisp
COPY broker-process.lisp /probe/broker-process.lisp

RUN sbcl --noinform --no-userinit --no-sysinit --disable-debugger \
    --script /probe/sbcl-build.lisp

ENTRYPOINT []

USER 65534:65534
WORKDIR /probe
CMD ["sh"]
